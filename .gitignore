# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Virtual Environments
venv/
env/
ENV/
.venv/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Large datasets & Model checkpoints (Never commit large raw binaries to git)
models/*.bin
models/*.safetensors
models/*.pt
models/*.pth
models/*.onnx
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Temporary files
temp/
tmp/
.pytest_cache/
.coverage
htmlcov/
